#!/usr/bin/python3
# Show which package builds are present in the local mirror of the build output
# repos (~/projects/repos/{lts,stable,beta}), as a markdown status table for one
# channel - one table per project (xpra, go-xpra and rust-xpra), separated by
# horizontal rules. The version checked is auto-detected separately for each
# project, as the latest version of it found in that channel's mirror.
#
# RHEL clones keep every point release around, so those are shown as a single
# "8.x" row with one labelled icon per point release (eg: 8.10 🟢 8.9 🔴 8.8 🔴).
#
# usage:
#   list-missing <beta|stable|lts> [--all-minors] [--links]
#     --all-minors  give each point release a row of its own, instead of
#                   grouping them into a single "8.x" row
#     --links       turn each status icon into a link to its download
#                   directory on xpra.org
#
# eg: list-missing lts

import glob
import os
import re
import sys
from collections import namedtuple

REPOS_ROOT = os.path.expanduser("~/projects/repos")
CHANNELS = ["lts", "stable", "beta"]
ARCHES = ["x86_64", "aarch64", "riscv64"]

# the projects built into these repos: `name` is also the rpm and deb package
# name, `installer` the prefix of the macOS and Windows installer filenames and
# `variants` the build flavours to show - only the main xpra build comes in a
# "Light" flavour, the others just have the regular ("full") build.
# only xpra has shipped macOS and Windows installers so far, so "Go-Xpra" and
# "Rust-Xpra" are the names those installers are expected to use.
Project = namedtuple("Project", "name installer variants")
PROJECTS = [
    Project("xpra", "Xpra", ["full", "light"]),
    Project("go-xpra", "Go-Xpra", ["full"]),
    Project("rust-xpra", "Rust-Xpra", ["full"]),
]

# kept in sync with repos/bin/update-rpm-repos.sh and repos/bin/update-deb-packages.py
RPM_DISTROS = ["Fedora", "CentOS", "almalinux", "rockylinux", "oraclelinux"]
# the RHEL clones ship a repository per point release, which we keep building for:
# their point releases are grouped into a single "8.x" row
RHEL_CLONES = ["almalinux", "rockylinux", "oraclelinux"]
# canonical arch -> on-disk arch name, or None if that combination doesn't exist
RPM_ARCH_MAP = {"x86_64": "x86_64", "aarch64": "aarch64", "riscv64": "riscv64"}

DEBIAN_DISTROS = "bullseye,bookworm,trixie,forky,sid".split(",")
UBUNTU_DISTROS = "jammy,noble,resolute".split(",")
DEB_ARCH_MAP = {"x86_64": "amd64", "aarch64": "arm64", "riscv64": "riscv64"}

MACOS_ARCH_MAP = {"x86_64": "x86_64", "aarch64": "arm64", "riscv64": None}
MSWINDOWS_ARCH_MAP = {"x86_64": "x86_64", "aarch64": "aarch64", "riscv64": None}

MINOR_RELEASE_RE = re.compile(r"^(\d+)\.(\d+)$")

# glob matching any version at all, used for projects which have no builds in
# this channel: like the patterns below, it stays anchored on a digit so that
# subpackages (eg: "xpra-audio-...") are still not mistaken for the core package
ANY_VERSION = "[0-9]*"

GREEN = "\U0001F7E2"
RED = "\U0001F534"
NA = "⚪"
BASE_URL = "https://xpra.org"


def natural_key(s):
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", s)]


def version_key(v):
    return tuple(int(p) for p in v.split("."))


def variant_prefix(project, arch, variant):
    if variant == "light":
        return "%s-Light-%s" % (project.installer, arch)
    return "%s-%s" % (project.installer, arch)


# ---- presence checks, keyed by the on-disk arch name ----

def rpm_present(project, channel, distro, variant, arch, version):
    arch_dir = os.path.join(REPOS_ROOT, channel, distro, variant, arch)
    if not os.path.isdir(arch_dir):
        return None
    pattern = os.path.join(arch_dir, "%s-%s-*.%s.rpm" % (project.name, version, arch))
    return bool(glob.glob(pattern))


def deb_present(project, channel, codename, arch, version):
    arch_dir = os.path.join(REPOS_ROOT, channel, codename, "main", "binary-%s" % arch)
    if not os.path.isdir(arch_dir):
        return None
    pattern = os.path.join(arch_dir, "%s_%s-*_%s.deb" % (project.name, version, arch))
    return bool(glob.glob(pattern))


def macos_present(project, channel, arch, variant, version):
    arch_dir = os.path.join(REPOS_ROOT, channel, "MacOS", arch)
    if not os.path.isdir(arch_dir):
        return None
    pattern = os.path.join(arch_dir, "%s-%s-r*.pkg" % (variant_prefix(project, arch, variant), version))
    return bool(glob.glob(pattern))


def mswindows_present(project, channel, arch, variant, version):
    arch_dir = os.path.join(REPOS_ROOT, channel, "MSWindows", arch)
    if not os.path.isdir(arch_dir) or os.path.islink(arch_dir):
        return None
    pattern = os.path.join(arch_dir, "%s_%s-r*.msi" % (variant_prefix(project, arch, variant), version))
    return bool(glob.glob(pattern))


# ---- version auto-detection ----

def version_regexes(project):
    # filename patterns for the core package of this project only (not
    # subpackages / debuginfo / dbgsym), used to discover which versions have
    # actually been built in a given channel. both the regular ("full") and
    # "Light" builds are recognised, since either one is evidence that a given
    # version was released.
    pkg = re.escape(project.name)
    installer = re.escape(project.installer)
    return (
        re.compile(r"^%s-(\d[\d.]*)-" % pkg),
        re.compile(r"^%s_(\d[\d.]*)(?:-r\d+)?-\d+_" % pkg),
        re.compile(r"^%s-(?:Light-)?(?:x86_64|arm64)-(\d[\d.]*)-r\d+\.pkg$" % installer),
        re.compile(r"^%s-(?:Light-)?(?:x86_64|aarch64)_(\d[\d.]*)-r\d+\.msi$" % installer),
    )


def file_version(regexes, filename):
    for regex in regexes:
        m = regex.match(filename)
        if m:
            return m.group(1)
    return None


def scan_versions(channel):
    # walk the channel's mirror just once, matching every project as we go:
    # returns the set of versions found for each project name
    versions = {project.name: set() for project in PROJECTS}
    project_regexes = [(project.name, version_regexes(project)) for project in PROJECTS]
    channel_dir = os.path.join(REPOS_ROOT, channel)
    for root, dirs, files in os.walk(channel_dir):
        # don't follow the "8" -> "8.10" / "arm64" -> "aarch64" style symlinks,
        # they would just duplicate work
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
        for f in files:
            for name, regexes in project_regexes:
                version = file_version(regexes, f)
                if version:
                    versions[name].add(version)
                    break
    return versions


def latest_versions(channel):
    # the latest version of each project found in this channel,
    # or None for projects which have no builds here at all
    return dict(
        (name, max(versions, key=version_key) if versions else None)
        for name, versions in scan_versions(channel).items()
    )


# ---- row discovery (distro/variant only, arch becomes a column) ----

def group_point_releases(rows):
    # for RHEL clones, gather the "X.Y" point releases (8.8, 8.9, 8.10) of a
    # given major version into a single "8.x" row listing them all, newest
    # first. releases that don't have this shape (eg: "43", "stream9",
    # "10-kitten", or oraclelinux's plain "9") are passed through unchanged,
    # since they aren't a run of point releases.
    groups = {}  # (distro, major) -> [release, ...]
    result = []
    for distro, release in rows:
        m = MINOR_RELEASE_RE.match(release)
        if distro not in RHEL_CLONES or not m:
            result.append((distro, release, [release], False))
            continue
        groups.setdefault((distro, int(m.group(1))), []).append(release)
    for (distro, major), releases in groups.items():
        releases.sort(key=version_key, reverse=True)
        result.append((distro, "%i.x" % major, releases, True))
    return result


def discover_rpm_rows(channel, all_minors):
    # returns (distro, variant, [release, ...], grouped) tuples: `variant` is the
    # label shown in the table and `releases` the on-disk directories it covers
    rows = set()
    for distro in RPM_DISTROS:
        distro_dir = os.path.join(REPOS_ROOT, channel, distro)
        if not os.path.isdir(distro_dir):
            continue
        for release in os.listdir(distro_dir):
            release_path = os.path.join(distro_dir, release)
            # skip the "8" -> "8.10" style latest-point-release symlinks,
            # the real versioned directory is checked directly
            if os.path.islink(release_path) or not os.path.isdir(release_path):
                continue
            rows.add((distro, release))
    if all_minors:
        return [(distro, release, [release], False) for distro, release in rows]
    return group_point_releases(rows)


def major_path(channel, distro, variant):
    # the "8" -> "8.10" symlink a grouped "8.x" row can point at
    major = variant[:-len(".x")]
    if os.path.exists(os.path.join(REPOS_ROOT, channel, distro, major)):
        return [distro, major]
    return None


def discover_deb_rows(channel):
    rows = set()
    for family, codenames in (("Debian", DEBIAN_DISTROS), ("Ubuntu", UBUNTU_DISTROS)):
        for codename in codenames:
            if os.path.isdir(os.path.join(REPOS_ROOT, channel, codename, "main")):
                rows.add((family, codename))
    return rows


def discover_macos_rows(project, channel):
    rows = set()
    for arch in MACOS_ARCH_MAP.values():
        if arch and os.path.isdir(os.path.join(REPOS_ROOT, channel, "MacOS", arch)):
            for variant in project.variants:
                rows.add(("macOS", variant))
    return rows


def discover_mswindows_rows(project, channel):
    rows = set()
    for arch in MSWINDOWS_ARCH_MAP.values():
        arch_dir = os.path.join(REPOS_ROOT, channel, "MSWindows", arch) if arch else None
        if arch_dir and os.path.isdir(arch_dir) and not os.path.islink(arch_dir):
            for variant in project.variants:
                rows.add(("Windows", variant))
    return rows


def status_icon(present):
    if present is None:
        return NA
    return GREEN if present else RED


def icon_markup(present, channel, path_parts, links):
    icon = status_icon(present)
    if not links or present is None or not path_parts:
        return icon
    return dir_link(icon, channel, path_parts)


def cell_collapsed(entries):
    # when none of the releases covered by a cell apply to this arch, a single
    # "not applicable" icon says so just as well as a row of them
    return all(present is None for _label, present, _path_parts in entries)


def cell_markup(entries, channel, links):
    # `entries` is a list of (label, present, path_parts), one per release covered
    # by this row: labels are only used when there is more than one release to
    # tell apart (eg: "8.10 🟢 8.9 🔴").
    if cell_collapsed(entries):
        return NA
    return " ".join(
        " ".join(x for x in (label, icon_markup(present, channel, path_parts, links)) if x)
        for label, present, path_parts in entries
    )


def count_icons(table_rows):
    # tally the icons as they are actually shown in the table, so that a cell
    # collapsed down to a single "not applicable" icon only counts once
    counts = {RED: 0, GREEN: 0, NA: 0}
    for _distro, _distro_path, _variant, _variant_path, arch_cells in table_rows:
        for arch in ARCHES:
            entries = arch_cells[arch]
            if cell_collapsed(entries):
                counts[NA] += 1
                continue
            for _label, present, _path_parts in entries:
                counts[status_icon(present)] += 1
    return counts


def dir_link(text, channel, path_parts):
    url = "%s/%s/%s/" % (BASE_URL, channel, "/".join(path_parts))
    return "[%s](%s)" % (text, url)


def label_markup(text, channel, path_parts, links):
    if not links or not path_parts:
        return text
    return dir_link(text, channel, path_parts)


def print_table(project, channel, version, all_minors=False, links=False):
    # projects which have no builds at all in this channel have no version to
    # check for, so every build they could have is simply shown as missing
    version_glob = version or ANY_VERSION

    # table_rows: (distro, distro_path_parts, variant, variant_path_parts,
    #              {canonical_arch: [(label, present, path_parts), ...]})
    table_rows = []

    for distro, variant, releases, grouped in discover_rpm_rows(channel, all_minors):
        arch_cells = {}
        for arch, disk_arch in RPM_ARCH_MAP.items():
            entries = []
            for release in releases:
                present = rpm_present(project, channel, distro, release, disk_arch, version_glob) if disk_arch else None
                # only a grouped "8.x" row needs its icons labelled with the release
                entries.append((release if grouped else "", present, [distro, release, disk_arch]))
            arch_cells[arch] = entries
        variant_path = major_path(channel, distro, variant) if grouped else [distro, variant]
        table_rows.append((distro, [distro], variant, variant_path, arch_cells))

    for family, codename in discover_deb_rows(channel):
        arch_cells = {}
        for arch, disk_arch in DEB_ARCH_MAP.items():
            present = deb_present(project, channel, codename, disk_arch, version_glob) if disk_arch else None
            arch_cells[arch] = [("", present, [codename, "main", "binary-%s" % disk_arch])]
        # "Debian"/"Ubuntu" is just our own grouping label, not a real directory
        table_rows.append((family, None, codename, [codename], arch_cells))

    for distro, variant in discover_macos_rows(project, channel):
        arch_cells = {}
        for arch, disk_arch in MACOS_ARCH_MAP.items():
            present = macos_present(project, channel, disk_arch, variant, version_glob) if disk_arch else None
            arch_cells[arch] = [("", present, ["MacOS", disk_arch] if disk_arch else None)]
        # "full"/"light" share the same directory, there is no variant-specific path
        table_rows.append((distro, ["MacOS"], variant, None, arch_cells))

    for distro, variant in discover_mswindows_rows(project, channel):
        arch_cells = {}
        for arch, disk_arch in MSWINDOWS_ARCH_MAP.items():
            present = mswindows_present(project, channel, disk_arch, variant, version_glob) if disk_arch else None
            arch_cells[arch] = [("", present, ["MSWindows", disk_arch] if disk_arch else None)]
        table_rows.append((distro, ["MSWindows"], variant, None, arch_cells))

    table_rows.sort(key=lambda r: (r[0], natural_key(r[2])))

    counts = count_icons(table_rows)
    print("## %s" % project.name)
    print()
    print("%s: %s" % (channel, version or "no version found"))
    print(", ".join("%s %i" % (icon, counts[icon]) for icon in (RED, GREEN, NA)))
    print()
    headers = ["distro", "variant"] + ARCHES
    print("| " + " | ".join(headers) + " |")
    print("|" + "|".join(["---"] * len(headers)) + "|")
    for distro, distro_path, variant, variant_path, arch_cells in table_rows:
        cells = [cell_markup(arch_cells[arch], channel, links) for arch in ARCHES]
        distro_cell = label_markup(distro, channel, distro_path, links)
        variant_cell = label_markup(variant, channel, variant_path, links)
        print("| %s | %s | %s |" % (distro_cell, variant_cell, " | ".join(cells)))


def main():
    args = sys.argv[1:]
    all_minors = "--all-minors" in args
    links = "--links" in args
    args = [a for a in args if a not in ("--all-minors", "--links")]

    if len(args) != 1 or args[0] not in CHANNELS:
        sys.stderr.write("usage: %s <beta|stable|lts> [--all-minors] [--links]\n" % sys.argv[0])
        sys.exit(1)

    channel = args[0]
    versions = latest_versions(channel)
    for i, project in enumerate(PROJECTS):
        if i:
            # markdown horizontal rule separating each project's table
            print()
            print("---")
            print()
        print_table(project, channel, versions[project.name], all_minors=all_minors, links=links)


if __name__ == "__main__":
    main()
